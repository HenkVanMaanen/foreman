#!/usr/bin/env bash
# Auto-run the strict gate before every commit: Biome (lint+format, warnings=errors) + tsc.
# Enabled via `core.hooksPath .githooks` (set by the package.json "prepare" script on install).
# Fast enough for every commit (Biome is Rust; typecheck is incremental).
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
if command -v bun >/dev/null 2>&1; then
  echo "[pre-commit] bun run check…"
  bun run check
else
  echo "[pre-commit] bun not found; skipping check" >&2
fi
