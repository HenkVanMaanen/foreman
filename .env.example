# foreman configuration (copy to .env). All optional; sensible defaults apply.

# --- claude subprocess ---
FOREMAN_CLAUDE_BIN=claude
# Model context window in tokens; drives the context watchdog marks. SET THIS TO YOUR
# MODEL'S REAL WINDOW — e.g. 1000000 for a 1M-context Opus/Sonnet — or foreman will recycle
# far too aggressively (a turn using 200k of a 1M window would trip an 80% mark set at 200k).
FOREMAN_CONTEXT_WINDOW=1000000
# Soft mark: nudge the agent to checkpoint at the next natural boundary (fraction).
FOREMAN_SOFT_MARK=0.60
# Hard mark: force checkpoint + fresh restart (fraction).
FOREMAN_HARD_MARK=0.80
# Watchdog: force-exit (so keeper respawns) if the supervisor makes no progress this long, in
# ms — recovers a silently-wedged harness that keeper's exit-only respawn can't see. Must
# exceed the longest legitimate quiet gap (agent parked on wait-reply / a long tool call, both
# ~600s); 0 disables. CHECK_MS is how often the stall test runs.
FOREMAN_WATCHDOG_TIMEOUT_MS=1200000
FOREMAN_WATCHDOG_CHECK_MS=30000

# --- re-login relay (src/relogin.ts) ---
# When claude's OAuth token dies the model is DOWN and cannot ask for help, so the supervisor
# relays the sign-in itself over the human channel: it sends the URL, waits on the same inbox
# watermark the idle-wait uses, and pastes the code the human replies with. 0 disables the relay
# (the loop then just exits and lets keeper.sh respawn). `foreman relogin [claude|codex]` drives
# the same flow by hand.
FOREMAN_RELOGIN=1
# codex CLI, used only by `foreman relogin codex` (device-auth; the supervisor loop re-auths
# claude only).
FOREMAN_CODEX_BIN=codex
# Test seam: report the FIRST stream frame of the run as an auth failure so the whole relay can be
# rehearsed end to end without logging anyone out. One-shot per run. Leave at 0 in production.
FOREMAN_FAKE_AUTH_REQUIRED=0

# --- durable memory ---
# Private git remote for the agent's notes. When set, the harness clones it into the notes
# dir on cold start and pulls on restart, and the agent pushes via `notes-sync` — so memory
# survives crashes and a fresh machine resumes prior state. Empty = notes are local-only.
FOREMAN_STATE_REPO=

# --- paths (relative to repo root unless absolute) ---
FOREMAN_NOTES_DIR=notes
FOREMAN_STATE_DIR=state
FOREMAN_WORKTREES_DIR=worktrees

# --- secrets store (age) ---
# The store is encrypted with `age`. The harness generates an X25519 identity at
# FOREMAN_AGE_IDENTITY on cold start if it is absent — nothing to set by hand. Point it at
# an existing identity to reuse a key across boxes. FOREMAN_AGE_RECIPIENT is optional: set
# the public key to encrypt on a machine that must NOT hold the private identity; if empty,
# the recipient is derived from the identity so capture stays non-interactive.
FOREMAN_AGE_IDENTITY=state/age-identity.txt
FOREMAN_AGE_RECIPIENT=

# --- observability dashboard ---
# Read-only web dashboard (`foreman dashboard`), bound to 127.0.0.1. Shows orchestrator
# health (alive/working/quiet/recycling/dead), live context %, an activity feed, and the
# agent's notes/tasks/*.md workers. SSH-tunnel this port to view from another machine.
FOREMAN_DASHBOARD_PORT=7878

# --- channels (consumed by the AGENT's own ask-human/wait-reply scripts, not the harness) ---
# The harness just passes these through to the agent's environment.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MATTERMOST_BASE_URL=
MATTERMOST_BOT_TOKEN=
MATTERMOST_CHANNEL_ID=
